{
  "forge": {
    "type": "github",
    "host": "github.com",
    "owner": "Crank-Git",
    "repo": "ja4plus-go",
    "remote": "origin"
  },
  "branchModel": "dev-and-live",
  "devBranch": "dev",
  "liveBranch": "master",
  "devIsDefault": false,
  "concurrency": 3,
  "batchSize": 4,
  "runLength": "4-batches",
  "prGranularity": "batch",
  "prAuthority": "autonomous",
  "deployTarget": null,
  "docsMcp": "none-webfetch-fallback",
  "review": {
    "when": "never"
  },
  "practices": {
    "tdd": true,
    "coverageFloor": true,
