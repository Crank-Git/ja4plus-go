{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go doc:*)",
      "Bash(go fmt:*)",
      "Bash(gofmt:*)",
      "Bash(go mod tidy)",
      "Bash(go mod download)",
      "Bash(go mod verify)",
      "Bash(go tool cover:*)",
      "Bash(go run ./cmd/ja4plus:*)",
      "Bash(golangci-lint run:*)",
      "Bash(govulncheck:*)",
      "Bash(make:*)",
      "Bash(./scripts/fetch-corpus.sh:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v gofmt >/dev/null || exit 0; for f in $CLAUDE_FILE_PATHS; do case \"$f\" in *.go) gofmt -w \"$f\" 2>/dev/null || true ;; esac; done"
          }
        ]
      }
    ]
  }
}
