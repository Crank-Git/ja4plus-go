# Build output
bin/
dist/

# The coverage profile that `make cover` and the CI test job write.
coverage.out

# Captures
*.pcap
*.pcapng

# Constructed captures are tracked. Several rulings are separated by no FoxIO vector, so a
# test builds its own packet and commits it. The rule above would swallow those files.
# The fetched FoxIO corpus stays ignored: it is FoxIO-licensed material.
!testdata/rulings/*.pcap
!testdata/rulings/*.pcapng
!testdata/prerelease/*.pcap
!testdata/prerelease/*.pcapng

# Dependencies
vendor/

# Claude Code
# CLAUDE.md and .claude/ are tracked: issue-flow workers run in git worktrees, which
# contain tracked files only, so ignored project rules are invisible to them.
.omc/
AGENTS.md
.claude/settings.local.json
.claude/worktrees/
.claude/agent-memory-local/
CLAUDE.local.md
.claude.local.md
.issue-flow.local.json

# Superpowers artifacts
docs/superpowers/

# Dev notes (not part of the library)
PYTHON_ISSUES.md
TODOS.md

# Documentation site build output. The pages under docs/ are tracked; the built site is not.
site/
.venv-docs/

# Mutation sweep scratch. The reports under docs/mutation_reports/ are tracked.
.gremlins/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
testdata/foxio/
